body {
  margin: 0;
  font-family: Arial;
  display: flex;
  height: 100vh;
  background: #0b141a;
  color: white;
}

.sidebar {
  width: 250px;
  background: #111b21;
  padding: 10px;
}

.chat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

#messages {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
}

.input {
  display: flex;
}

input {
  flex: 1;
  padding: 10px;
}

button {
  padding: 10px;
  background: #00a884;
  border: none;
  color: white;
}
